<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sist.dao.food-mapper">
<!-- 
	1. HTML 기본 태그
	2. CSS: 선택자, 약간의 수정
	3. JavaScript: 기본문법(변수,제어문,연산자,배열)
					- String, Number,Boolean,Date 
		- 내장객체
			- window / document / history / location
		- 태그 읽기(DOM)
			- querySelector() / getElementById()
	4. JQuery / Ajax
	5. Java: 기본문법, Annotation, XML 파싱
	6. JSP: 지시자(taglib), 내장객체(request,response,session,application)
	7. MVC 구조
		- 요청(request) => Controller => Model => DAO => Model => Controller => JSP
	8. Oracle(DB)
		- CRUD(SELECT, CREATE, UPDATE, DELETE)
		- 내장 함수, 연산자, JOIN, SubQuery
	9. MyBatis: SQL문장 제작 => 처리 로직(DAO)과 나눠서 작업
 -->
 <!-- id는 중복x, 메소드명 일치 -->
 <!-- 
 	resultType=""
 		- List<>: selectList, 나머지: selectOne 
 	
 	- 함수 사용시 반드시 별칭(멤버변수로 설정)
 	- 변경해야 하는 데이터가 많은 경우에는 <resultMap>		
 		
 -->
<select id="foodListData" resultType="FoodVO" parameterType="int">
	SELECT no,name,poster,address
	FROM food
	ORDER BY no ASC
	OFFSET #{start} ROW FETCH NEXT 12 ROWS ONLY
</select>
<select id="foodTotalPage" resultType="int">
	SELECT CEIL(COUNT(*)/12.0) FROM food
</select>
<select id="foodDetailData" resultType="FoodVO" parameterType="int">
	SELECT * FROM food WHERE no=#{no}
</select>
<select id="foodFindListData" resultType="FoodVO" parameterType="hashmap">
	SELECT no,poster,name,address
	FROM food
	WHERE ${column} LIKE '%'||#{ss}||'%'
	OFFSET #{start} ROWS FETCH NEXT 12 ROWS ONLY
</select>
<!-- 
	데이터형을 1개만 지정 => hashmap 사용
	selectOne(String id, Object obj)
	selectList
	insert
	update
	delete
	=> 데이터형 자동 처리 => 제네릭
 -->
<select id="foodFindTotalPage" resultType="int" parameterType="hashmap">
	SELECT CEIL(COUNT(*)/12.0)
	FROM food
	WHERE ${column} LIKE '%'||#{ss}||'%'
</select>
</mapper>