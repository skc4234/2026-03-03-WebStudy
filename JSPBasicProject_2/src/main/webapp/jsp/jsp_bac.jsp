    pageEncoding="UTF-8"%>
<%--
	relative : 원래 자리에서 입력된 위치로 약간 이동
	
 --%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
<style type="text/css">
.relative {
	position: relative;
	background-color: blue;
	top:20px;
	left=20px;
	width: 100px;
	height: 100px;
}
</style>
</head>
<body>
	<div class="relative">
		div
	</div>
</body>
</html>