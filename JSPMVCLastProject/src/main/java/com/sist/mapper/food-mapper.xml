<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sist.mapper.food-mapper">
	<!-- 1. 맛집 목록 출력 -->
	<select id="foodListData" parameterType="int" resultType="FoodVO">
		<!-- id:구분자 / resultType:리턴값 데이터형 / parameterType:매개변수 데이터형 / resultMap:원하는 방식으로 값채우기(JOIN 등) -->
		<!-- 
			  String sql="SELECT ~";
			  PreparedStatement ps=conn.preparedStatement(sql);
			  ps.setInt(1,start); 			// parameterType
			  ResultSet rs=ps.executeQuery();
			  while(rs.next()) {
			  	FoodVO vo = new FoodVO(); 	// resultType
			  	vo.setNo(rs.getInt(1));
			  	...
			  }
		 -->
		<!-- 1. mapper.xml 파싱 => 필요한 데이터를 읽음 -->
		SELECT no,poster,name,address
		FROM food
		ORDER BY no ASC
		OFFSET #{start} ROWS FETCH NEXT 12 ROWS ONLY
	</select>
	
	<!-- 1-1. 총 페이지 수 -->
	<select id="foodTotalPage" resultType="int">
		SELECT CEIL(COUNT(*)/12.0) FROM food
	</select>
	
	<!-- 2. 상세 페이지 -->
	<select id="foodDetailData" resultType="FoodVO" parameterType="int">
		SELECT *
		FROM food
		WHERE no=#{no}
	</select>
</mapper>