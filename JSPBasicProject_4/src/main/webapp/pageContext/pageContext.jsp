<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<%-- 
	pageContext : PageContext 클래스 객체
	웹 흐름 제어-> 다른 객체 읽기
	
	pageContext.include() : JSP 특정 부분에 다른 JSP 파일 첨부
		- request를 공유한다
		=> <jsp:include>
	pageContext.forward() : 화면 이동(request 유지)
		- <jsp:forward>
--%>
