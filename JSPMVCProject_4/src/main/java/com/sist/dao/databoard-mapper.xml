<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
 PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 
	mapper.xml이 하는일
		- PreparedStatement
		- ResultSet
		- SQL 문장 작성
 -->
<mapper namespace="com.sist.dao.databoard-mapper">
	<sql id="where-no"> <!-- 중복 코드 제거 -->
		WHERE no=#{no}
	</sql>
	
	<!-- 
	resultMap* : 조인시에 주로 사용(VO+VO)
	parameterMap* : PROCEDURE
	sql* : 공통으로 사용되는 SQL이 있는 경우(반복 제거)
	insert*
	update*
	delete*
	select*
	 -->
	 
	<!--
		1) SQL 문장 2) resultType : return형 입력 3) parameterType : 매개변수 데이터형 입력
													=> ?에 값주입 : #{Xxx}=> vo.getXxx
		1. 목록 출력
			<select id="기능명"> SQL 문장 </select>
			resultType: 결과값 받기(리턴타입)
			parameterType : 매개변수
			
			```
			ResultSet rs = ps.executeQuery()
			while(rs.next()) {
				BoardVO vo = new BoardVO() // vo에 결과값을 받아야함 => resultType
			}
			```
	 -->
	 <!-- 1. 목록 출력 -->
	<select id="databoardListData" resultType="DataBoardVO" parameterType="int" >
		SELECT no,subject,name,TO_CHAR(regdate,'YYYY-MM-DD') as dbday, hit
		FROM mvcDataBoard 
		ORDER BY no DESC 
		OFFSET #{start} ROWS FETCH NEXT 10 ROWS ONLY
	</select>
	<select id="databoardTotalPage" resultType="int">
		SELECT CEIL(COUNT(*)/10.0) FROM mvcdataboard
	</select>
	
	<!-- 2. 글쓰기 -->
	<insert id="databoardInsert" parameterType="DataBoardVO">
		<!-- 
		#{name} == vo.getName()
		 -->
		INSERT INTO mvcDataBoard VALUES(
			mdb_no_seq.nextval,
			#{name},
			#{subject},
			#{content},
			#{pwd},
			SYSDATE,
			0,
			#{filename},
			#{filesize}
		)
	</insert>
	
	<!-- 3. 상세보기(SQL문장 2개) -->
	<!-- 조회수 증가 -->
	<update id="hitIncrement" parameterType="int">
		UPDATE mvcDataBoard SET hit=hit+1
		<include refid="where-no" />
	</update>
	<!-- 실제 데이터 읽기 -->
	<select id="dataBoardDetailData" parameterType="int" resultType="DataBoardVO">
		SELECT no,name,subject,content,hit,TO_CHAR(regdate,'YYYY-MM-DD') as dbday,filesize,filename 
		FROM mvcDataBoard 
		<include refid="where-no" />
	</select>
</mapper>