<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration
 PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
 "https://mybatis.org/dtd/mybatis-3-config.dtd">
<!-- 
	   예제
		food => 댓글+지도
		goods => 장바구니+결제창
		Ajax (자체 처리) : JavaScript(바닐라JS) => JQuery(라이브러리)		
		
       1. 동작 순서
       	- Config.xml (1개만 설정)
       	- mapper.xml (테이블(VO)당 하나씩 설정) : xml 또는 annotation
       	
       	1) 사용자 요청(브라우저)
       	2) Controller(DispatcherServlet) 요청 받기
       	3) Model에 있는 메소드 호출 (@RequestMapping)
       		1) 데이터베이스 연동
       		2) getConnection : Config.xml
       	 	   disConnection
       		   	==> SqlSessionFactory
       		3) mapper.xml => SqlSession(PreparedStatement, ResultSet)
       			==> mapper.xml에 있는 SQL문장을 읽어서 SqlSession에서 처리
        
        1. 연결
        ==================
        2. SQL 문장 읽기
        3. SQL 문장 전송
        4. SQL 문장 실행 요청
        5. 결과값 받기
        ====================> SqlSession
        6. 닫기
 -->

<configuration>
	<!-- 0. .properties 파일 읽기 -->
	<properties resource="db.properties" />
	
	<!-- 1. VO 등록 -->
	<typeAliases>
	 <typeAlias type="com.sist.vo.FoodVO" alias="FoodVO"/>
	 <typeAlias type="com.sist.vo.MemberVO" alias="MemberVO"/>
	 <typeAlias type="com.sist.vo.ReplyVO" alias="ReplyVO"/>
	</typeAliases>
	
	<!-- 2. 데이터베이스 환경설정 -->
	<environments default="development">
		<environment id="development">
			
			<!-- 2-1. transaction 설정(JDBC/MANAGE) -->
			<transactionManager type="JDBC"/>
	
			<!-- 2-2. 정보 설정 -->
			<!-- POOLED(DBCP) / UNPOOLED(JDBC) -->
			<dataSource type="POOLED" >
				<property name="driver" value="${driver}"/>
				<property name="url" value="${url}"/>
				<property name="username" value="${username}"/>
				<property name="password" value="${password}"/>
			</dataSource>
			
		</environment>
	</environments>
	
	<!-- 3. Mapper 등록 -->
	<mappers>
	 <mapper resource="com/sist/mapper/food-mapper.xml"/>
	 <!-- 
	 	  include
	 	  <!ENTITY nbsp ""> : &nbsp;
	 	  <!ENTITY rt ""> : &lt;
	 	  <!ENTITY gt ""> : &gt;
	 	  <!ENTITY xml "파일명"> : &xml ;
	 	  XML 단점 : 커질수록 속도가 느려진다
	  -->
	</mappers>
</configuration>