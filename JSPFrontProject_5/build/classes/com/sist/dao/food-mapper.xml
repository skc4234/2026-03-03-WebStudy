<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sist.dao.food-mapper">
<select id="foodListData" resultType="FoodVO" parameterType="int">
	SELECT no,name,poster
	FROM food
	ORDER BY no ASC
	OFFSET #{start} ROWS FETCH NEXT 12 ROWS ONLY
</select>
<!-- 
	// rownum은 중간부터 가져올 수 없다 => 인라인뷰
	SELECT no,poster,name,num
	FROM (SELECT no,poster,name,rownum as num
		FROM (SELECT no,poster,name
			FROM food ORDER BY no ASC))
	WHERE num BETWEEN #{start} AND #{end}
	
	// MySQL
	SELECT no,poster,name
	FROM food
	ORDER BY no ASC
	LIMIT ?,12
 -->
<select id="foodTotalPage" resultType="int">
	SELECT CEIL(COUNT(*)/12.0) FROM food
</select>
<!-- 
	?에 값 넣기
	parameterType="int"    : setInt()
	parameterType="String" : setString()
	**parameterType="hashMap" : HashMap
		- BETWEEN #{start} AND #{end}
			```
			Map map = new HashMap() 
			map.put("start",1)
			map.put("end",10)
			map.get("start")
			map.get("end")
			```
	**parameterType="FoodVO"
		- vo.getXxx()
 -->
<select id="foodDetailData" resultType="FoodVO" parameterType="int">
	SELECT * FROM food WHERE no=#{no}
</select>
</mapper>