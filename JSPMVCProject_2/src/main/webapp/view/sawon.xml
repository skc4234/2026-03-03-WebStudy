<?xml version="1.0" encoding="UTF-8"?>
<!-- 
	확장된 ML => 지원하는 태그가 없다 => 전부 사용자 정의 태그 => 시멘텍 태그 만들기(알아보기 쉬운)
	XML을 이용하는 라이브러리
		- Spring : 환경설정 / 라이브러리 => m2(pom.xml)
			- 라이브러리 : 배포/프로젝트/버전관리 => maven
			- gradle : property => SpringBoot
		- MyBatis : SQL 문장 / 환경 설정(DB)
		
	- XML 문서
		- 문서형 데이터베이스(B2B)
		- XML 문법이 강력하다
			- 트리형태의 프로그램 => 루트태그가 반드시 있다
			- 여는태그과 닫는태그가 일치해야한다
			- 닫는 태그가 없는 경우 <태그 />
			- 속성값이 있는 경우 속성=""
			- XML 파싱 => 지정된 데이터 추출
			- XML은 무겂다 => 전송 시 속도가 느려짐
			 	=> XML 대체 => JSONs
 -->
 
 <sawon>
	<list>
		<sabun>1</sabun>
		<name>홍길동</name>
		<dept>개발부</dept>
		<job>대리</job>
		<loc>서울</loc>
	</list>
 </sawon>