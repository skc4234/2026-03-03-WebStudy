<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration
 PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
 "https://mybatis.org/dtd/mybatis-3-config.dtd">
<!-- Connection + VO + SQL문장 -->
<configuration>
	<!-- 
	(properties?, settings?, typeAliases?, typeHandlers?, objectFactory?, objectWrapperFactory?, 
	 reflectorFactory?, plugins?, environments?, databaseIdProvider?, mappers?)
	 configuration은 순서에 맞춰서 지정
	 
	 properties : 데이터베이스 정보 읽기 => .properties 파일 불러오기
	 settings : 캐시 메모리 활용
	 **typeAliases : VO 등록
	 typeHandlers : 데이터 변경
	 **mappers : SQL 문장 위치 확인
	 **environments : Connection 설정
	 	- transcationManager : JDBC / MANAGE(미리 설정한 파일)
	 	- dataSource : POOLED(DBCP) / UNPOOLED(JDBC)
	 		- property : driver, oracle 주소 등 등록
	 -->
	 
	 <!-- 1. VO 등록 -->
	 <typeAliases>
	 	<typeAlias type="com.sist.vo.DataBoardVO" alias="DataBoardVO"/>
	 </typeAliases>
	 
	 <!-- 2. Connection 설정 => getConnection() / disConnection() -->
	 <environments default="development">
	 	<environment id="development">
	 		 <transactionManager type="JDBC" />
	 		 <dataSource type="POOLED" >
	 		 	<property name="driver" value="oracle.jdbc.driver.OracleDriver"/>
	 		 	<property name="url" value="jdbc:oracle:thin:@localhost:1521:XE"/>
	 		 	<property name="username" value="hr"/>
	 		 	<property name="password" value="happy"/>
	 		 	<!-- 
	 		 		추가 property 값
	 		 			maxActive=8(기본값)
	 		 			maxIdle=8(기본값)
	 		 			maxWait=10000(기본값)
	 		 	 -->
	 		 </dataSource>
	 	</environment>
	 </environments>
	 
	 <!-- 3. SQL 문장 파일 위치 등록 -->
	 <mappers>
	 	<mapper resource="com/sist/dao/databoard-mapper.xml"/>
	 </mappers>
</configuration>